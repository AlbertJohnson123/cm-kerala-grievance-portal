# Environment Variables - CM Kerala Grievance Redressal Portal
# Copy this file to .env and fill in the values

# Prisma SQLite database file path
DATABASE_URL="file:./prisma/dev.db"

# NextAuth secret key (generate a random string for production)
NEXTAUTH_SECRET=""

# NextAuth URL (the base URL of your app)
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini API key (optional - mock AI is used if empty)
GEMINI_API_KEY=""
