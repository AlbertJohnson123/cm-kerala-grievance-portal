generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  mobile          String?
  passwordHash    String
  role            String    @default("CITIZEN")
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  grievances      Grievance[]
  grievanceHistory GrievanceHistory[]
  feedback        Feedback[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Department {
  id          String      @id @default(cuid())
  name        String      @unique
  description String
  code        String      @unique
  officers    User[]
  grievances  Grievance[]
  assignments GrievanceAssignment[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Grievance {
  id              String    @id @default(cuid())
  referenceNumber String    @unique
  citizenId       String
  citizen         User      @relation(fields: [citizenId], references: [id])
  district        String
  category        String
  subject         String
  description     String
  priority        String    @default("MEDIUM")
  status          String    @default("SUBMITTED")
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  aiSuggestedDept    String?
  aiSuggestedCategory String?
  aiSuggestedPriority String?
  aiSummary          String?
  isDuplicate        Boolean @default(false)
  adminRemarks       String?
  attachments     Attachment[]
  history         GrievanceHistory[]
  assignments     GrievanceAssignment[]
  feedback        Feedback[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model GrievanceHistory {
  id          String    @id @default(cuid())
  grievanceId String
  grievance   Grievance @relation(fields: [grievanceId], references: [id])
  status      String
  remarks     String?
  changedById String
  changedBy   User      @relation(fields: [changedById], references: [id])
  createdAt   DateTime  @default(now())
}

model GrievanceAssignment {
  id           String     @id @default(cuid())
  grievanceId  String
  grievance    Grievance  @relation(fields: [grievanceId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  actionReport String?
  resolvedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Attachment {
  id          String    @id @default(cuid())
  grievanceId String
  grievance   Grievance @relation(fields: [grievanceId], references: [id])
  filename    String
  url         String
  fileType    String
  createdAt   DateTime  @default(now())
}

model Feedback {
  id          String    @id @default(cuid())
  grievanceId String
  grievance   Grievance @relation(fields: [grievanceId], references: [id])
  citizenId   String
  citizen     User      @relation(fields: [citizenId], references: [id])
  rating      Int
  comment     String?
  createdAt   DateTime  @default(now())
}

model ContactEnquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}
